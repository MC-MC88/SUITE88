<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>vocal88</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Inter:wght@300;400;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
    body.theme-sunset {
        --bg: #1a0e07;
        --bg-grad-1: #2a1408;
        --bg-grad-2: #140803;
        --panel: #23130a;
        --panel-border: #3d2014;
        --card: #2e1a0e;
        --card-hover: #3d2416;
        --card-selected: #4a2c1a;
        --accent: #f59e0b;
        --accent-bright: #fbbf24;
        --accent-glow: rgba(245, 158, 11, 0.35);
        --text: #fef3c7;
        --text-mid: #d4a574;
        --text-dim: #8a6a45;
        --danger: #ef4444;
        --danger-glow: rgba(239, 68, 68, 0.35);
        --success: #10b981;
        --shadow: 0 4px 24px rgba(0, 0, 0, 0.55);
    }

    body.theme-tropical {
        --bg: #f0e5c2;
        --bg-grad-1: #f5ecd0;
        --bg-grad-2: #e8dcb4;
        --panel: #faf3da;
        --panel-border: #d4c69a;
        --card: #ffffff;
        --card-hover: #f7efd3;
        --card-selected: #e8f0e8;
        --accent: #1e5670;
        --accent-bright: #2d7a9c;
        --accent-glow: rgba(30, 86, 112, 0.25);
        --text: #2a1f14;
        --text-mid: #5a4a34;
        --text-dim: #8a7a62;
        --danger: #c0392b;
        --danger-glow: rgba(192, 57, 43, 0.25);
        --success: #1f5c3d;
        --shadow: 0 4px 24px rgba(60, 40, 20, 0.15);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
        min-height: 100vh;
        font-family: 'Inter', -apple-system, sans-serif;
        color: var(--text);
        background: linear-gradient(180deg, var(--bg-grad-1) 0%, var(--bg-grad-2) 100%);
        background-attachment: fixed;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
    }

    header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 28px;
        background: var(--panel);
        border-bottom: 1px solid var(--panel-border);
        position: sticky;
        top: 0;
        z-index: 30;
    }

    .logo {
        font-family: 'Sora', sans-serif;
        font-weight: 700;
        font-size: 1.4rem;
        letter-spacing: -0.02em;
        color: var(--text);
    }

    .logo-text span { color: var(--accent); }

    .header-right { display: flex; align-items: center; gap: 14px; }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        padding: 7px 14px;
        border-radius: 999px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: var(--success);
        text-transform: uppercase;
        white-space: nowrap;
    }

    .status-pill.recording { background: rgba(239, 68, 68, 0.14); border-color: rgba(239, 68, 68, 0.4); color: var(--danger); }
    .status-pill.playing { background: var(--accent-glow); border-color: var(--accent); color: var(--accent); }
    .status-pill.error { background: rgba(239, 68, 68, 0.2); border-color: var(--danger); color: var(--danger); }
    .status-pill.sharing { background: var(--accent-glow); border-color: var(--accent); color: var(--accent); }
    .status-pill.downloading { background: rgba(16, 185, 129, 0.18); border-color: var(--success); color: var(--success); }
    .status-pill.converting { background: rgba(139, 92, 246, 0.18); border-color: #8b5cf6; color: #c4b5fd; }

    .status-dot {
        width: 7px; height: 7px;
        border-radius: 50%;
        background: currentColor;
        box-shadow: 0 0 8px currentColor;
    }

    .theme-toggle {
        display: flex;
        background: var(--card);
        border: 1px solid var(--panel-border);
        border-radius: 999px;
        padding: 3px;
        gap: 2px;
    }

    .theme-btn {
        background: transparent;
        border: none;
        width: 34px; height: 30px;
        border-radius: 999px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text);
        opacity: 0.5;
        transition: opacity 0.2s ease;
    }

    .theme-btn:hover { opacity: 0.85; }
    .theme-btn.active { background: var(--accent); opacity: 1; color: var(--bg); }
    .theme-btn svg { display: block; }

    main {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 22px;
        padding: 22px 28px 0;
        max-width: 1240px;
        margin: 0 auto;
        min-height: calc(100vh - 170px);
    }

    .gesture-panel {
        background: var(--panel);
        border: 1px solid var(--panel-border);
        border-radius: 18px;
        padding: 26px 22px;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        box-shadow: var(--shadow);
    }

    .hold-bar {
        position: absolute;
        top: 0; left: 0;
        height: 3px;
        width: 0%;
        background: var(--accent);
        box-shadow: 0 0 14px var(--accent-glow);
        transition: width 0.08s linear;
    }

    .gesture-display {
        text-align: center;
        padding: 8px 0 18px;
        border-bottom: 1px solid var(--panel-border);
    }

    .gesture-emoji {
        font-size: 4.2rem;
        line-height: 1;
        margin-bottom: 14px;
        display: inline-block;
    }

    .gesture-name {
        font-family: 'Sora', sans-serif;
        font-weight: 600;
        font-size: 1.05rem;
        letter-spacing: 0.02em;
        color: var(--text);
        min-height: 1.3em;
        margin-bottom: 6px;
    }

    .gesture-hint {
        font-size: 0.78rem;
        color: var(--text-dim);
        line-height: 1.55;
        min-height: 2.4em;
        padding: 0 8px;
    }

    .recording-timer {
        margin-top: 20px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 2.2rem;
        color: var(--danger);
        text-shadow: 0 0 22px var(--danger-glow);
        display: none;
    }

    .recording-timer.active { display: block; }

    .guide { padding: 20px 4px 0; flex: 1; }

    .guide-title {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.22em;
        color: var(--text-dim);
        text-transform: uppercase;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .guide-title::after { content: ""; flex: 1; height: 1px; background: var(--panel-border); }

    .guide-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 10px;
        border-radius: 10px;
        margin-bottom: 3px;
        border: 1px solid transparent;
        cursor: pointer;
    }

    .guide-row.active { background: var(--accent-glow); border-color: var(--accent); }

    .guide-emoji { font-size: 1.35rem; width: 30px; text-align: center; }
    .guide-text { font-size: 0.78rem; color: var(--text-mid); }
    .guide-row.active .guide-text { color: var(--text); }

    .guide-count {
        margin-left: auto;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        color: var(--text-dim);
        padding: 2px 7px;
        border-radius: 5px;
        background: var(--card);
    }

    .guide-row.active .guide-count { background: var(--accent); color: var(--bg); }

    .guide-divider {
        height: 1px;
        background: var(--panel-border);
        margin: 12px 4px 10px;
        opacity: 0.7;
    }

    .guide-subtitle {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.62rem;
        letter-spacing: 0.22em;
        color: var(--text-dim);
        text-transform: uppercase;
        margin-bottom: 8px;
        padding: 0 4px;
    }

    .notes-panel {
        background: var(--panel);
        border: 1px solid var(--panel-border);
        border-radius: 18px;
        padding: 22px;
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow);
        min-width: 0;
    }

    .notes-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--panel-border);
        margin-bottom: 16px;
        gap: 12px;
    }

    .notes-header h2 {
        font-family: 'Sora', sans-serif;
        font-weight: 600;
        font-size: 1.05rem;
        color: var(--text);
        white-space: nowrap;
    }

    .notes-nav { display: flex; align-items: center; gap: 8px; }

    .nav-btn {
        width: 30px; height: 30px;
        border-radius: 9px;
        background: var(--card);
        border: 1px solid var(--panel-border);
        color: var(--text-mid);
        font-size: 1rem;
        cursor: pointer;
    }

    .notes-count-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        padding: 4px 11px;
        border-radius: 999px;
        background: var(--accent-glow);
        color: var(--accent);
        border: 1px solid var(--accent);
        min-width: 34px;
        text-align: center;
    }

    .notes-list {
        display: flex;
        flex-direction: row;
        gap: 12px;
        overflow-x: auto;
        overflow-y: hidden;
        flex: 1;
        padding: 8px 4px 16px;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        min-height: 220px;
    }

    .empty-state {
        flex: 1 0 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: var(--text-dim);
        font-size: 0.85rem;
        line-height: 1.8;
        padding: 40px 20px;
    }

    .empty-state .big-emoji { font-size: 2.4rem; display: block; margin-bottom: 12px; opacity: 0.55; }

    .note-item {
        flex: 0 0 auto;
        width: 188px;
        scroll-snap-align: center;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background: var(--card);
        border-radius: 16px;
        padding: 14px;
        border: 1px solid transparent;
        cursor: pointer;
    }

    .note-item.selected { border-color: var(--accent); background: var(--card-selected); box-shadow: 0 0 0 1px var(--accent); }
    .note-item.playing { border-color: var(--danger); }

    .note-head { display: flex; align-items: center; justify-content: space-between; }

    .note-play {
        width: 40px; height: 40px;
        border-radius: 50%;
        background: var(--accent-glow);
        border: 1.5px solid var(--accent);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        cursor: pointer;
        padding-left: 3px;
    }

    .note-item.playing .note-play { background: var(--danger); border-color: var(--danger); color: #fff; padding-left: 0; }

    .note-actions { display: flex; gap: 4px; }

    .note-download,
    .note-share {
        background: transparent;
        border: 1px solid var(--panel-border);
        color: var(--text-mid);
        width: 28px;
        height: 28px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .note-download:hover,
    .note-share:hover {
        border-color: var(--accent);
        color: var(--accent);
        background: var(--accent-glow);
    }

    .note-delete {
        background: transparent;
        border: none;
        color: var(--text-dim);
        font-size: 0.95rem;
        cursor: pointer;
        padding: 6px 8px;
        opacity: 0.5;
    }

    .note-wave { display: flex; align-items: flex-end; gap: 2px; height: 54px; }
    .note-wave span { flex: 1; min-width: 2px; background: var(--text-dim); border-radius: 2px; opacity: 0.45; }
    .note-item.selected .note-wave span { background: var(--accent); opacity: 0.8; }
    .note-item.playing .note-wave span { background: var(--danger); opacity: 0.9; }

    .note-meta {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.66rem;
        color: var(--text-dim);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .hand-preview {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 200px;
        height: 150px;
        border-radius: 14px;
        border: 2px solid var(--panel-border);
        background: var(--card);
        z-index: 100;
        opacity: 0.92;
        overflow: hidden;
    }

    #handCanvas { width: 100%; height: 100%; display: block; }

    .hand-preview-label {
        position: absolute;
        bottom: 6px;
        left: 10px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.5rem;
        letter-spacing: 0.18em;
        color: var(--text-dim);
        text-transform: uppercase;
        pointer-events: none;
    }

    .toast {
        position: fixed;
        top: 80px;
        left: 50%;
        transform: translateX(-50%) translateY(-20px);
        background: var(--panel);
        border: 1px solid var(--accent);
        color: var(--text);
        padding: 12px 24px;
        border-radius: 12px;
        font-size: 0.85rem;
        font-family: 'Inter', sans-serif;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3), 0 0 20px var(--accent-glow);
        z-index: 2500;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease, transform 0.25s ease;
        display: flex;
        align-items: center;
        gap: 10px;
        max-width: 90vw;
    }

    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    .toast .toast-icon { font-size: 1.15rem; }

    .privacy-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.9);
        backdrop-filter: blur(16px);
        z-index: 3000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .privacy-card {
        background: var(--panel);
        border: 1px solid var(--panel-border);
        border-radius: 24px;
        padding: 36px 32px 28px;
        max-width: 460px;
        width: 100%;
        box-shadow: 0 30px 100px rgba(0, 0, 0, 0.5);
        line-height: 1.7;
        color: var(--text);
    }

    .privacy-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        border: 1.5px solid var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin: 0 auto 22px;
        color: var(--accent);
    }

    .privacy-card h2 {
        font-family: 'Sora', sans-serif;
        font-weight: 600;
        font-size: 1.3rem;
        text-align: center;
        margin-bottom: 20px;
    }

    .privacy-card ul { list-style: none; margin-bottom: 24px; }

    .privacy-card li {
        padding: 9px 0 9px 26px;
        position: relative;
        opacity: 0.75;
        border-bottom: 1px solid var(--panel-border);
        font-size: 0.88rem;
        font-weight: 300;
    }

    .privacy-card li:last-child { border-bottom: none; }
    .privacy-card li::before { content: "—"; position: absolute; left: 0; color: var(--accent); }
    .privacy-card .hl { font-weight: 600; opacity: 1; }

    .privacy-card button {
        width: 100%;
        background: var(--accent);
        color: var(--bg);
        border: none;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.8rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        padding: 16px;
        border-radius: 14px;
        cursor: pointer;
    }

    .privacy-card button:disabled { opacity: 0.5; cursor: wait; }

    .error-note {
        display: none;
        padding: 12px 14px;
        background: rgba(255, 71, 87, 0.12);
        border: 1px solid rgba(255, 71, 87, 0.4);
        border-radius: 10px;
        color: #ff8a95;
        font-size: 0.78rem;
        line-height: 1.5;
        margin-bottom: 18px;
        text-align: center;
    }

    .error-note.show { display: block; }

    .step-note {
        display: none;
        padding: 10px 14px;
        background: var(--accent-glow);
        border: 1px solid var(--accent);
        border-radius: 10px;
        color: var(--accent);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        text-align: center;
        margin-bottom: 18px;
        letter-spacing: 0.05em;
    }

    .step-note.show { display: block; }

    footer {
        text-align: center;
        padding: 22px 20px 26px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        color: var(--text-dim);
        line-height: 1.8;
    }

    footer .dot { margin: 0 6px; opacity: 0.5; }

    @media (max-width: 860px) {
        header { padding: 14px 18px; }
        .logo { font-size: 1.2rem; }
        .status-pill { font-size: 0.62rem; padding: 5px 10px; }
        main { grid-template-columns: 1fr; padding: 14px 16px 0; gap: 14px; }
        .gesture-panel { padding: 20px 16px; }
        .gesture-emoji { font-size: 3.4rem; }
        .recording-timer { font-size: 1.8rem; }
        .notes-panel { padding: 16px; }
        .note-item { width: 165px; }
        .hand-preview { width: 120px; height: 90px; bottom: 14px; right: 14px; }
        .hand-preview-label { font-size: 0.42rem; bottom: 4px; left: 8px; }
        footer { font-size: 0.62rem; padding: 16px 12px 20px; }
        .toast { top: 68px; font-size: 0.78rem; padding: 10px 18px; }
    }
</style>
</head>
<body class="theme-sunset">

<header>
    <div class="logo">vocal<span>88</span></div>
    <div class="header-right">
        <div class="status-pill" id="statusPill">
            <span class="status-dot"></span>
            <span id="statusText">Loading</span>
        </div>
        <div class="theme-toggle">
            <button class="theme-btn active" data-theme="sunset" title="Sunset">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
                </svg>
            </button>
            <button class="theme-btn" data-theme="tropical" title="Tropical">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 21V11"/>
                    <path d="M12 11C9 8 5 8 3 10c3 1 6 1 9 1z"/>
                    <path d="M12 11c3-3 7-3 9-1-3 1-6 1-9 1z"/>
                    <path d="M12 11c0-4 1-6 3-7-1 3-2 5-3 7z"/>
                </svg>
            </button>
        </div>
    </div>
</header>

<main>
    <section class="gesture-panel">
        <div class="hold-bar" id="holdBar"></div>
        <div class="gesture-display">
            <div class="gesture-emoji" id="gestureEmoji">👋</div>
            <div class="gesture-name" id="gestureName">SHOW YOUR HAND</div>
            <div class="gesture-hint" id="gestureHint">Show an open palm to start recording.</div>
            <div class="recording-timer" id="recordingTimer">00:00</div>
        </div>

        <div class="guide">
            <div class="guide-title">Gesture Guide</div>
            <div class="guide-row" data-gesture="OPEN_PALM">
                <span class="guide-emoji">✋</span>
                <span class="guide-text">Open palm → start recording</span>
                <span class="guide-count">5</span>
            </div>
            <div class="guide-row" data-gesture="FIST">
                <span class="guide-emoji">✊</span>
                <span class="guide-text">Fist → stop &amp; save</span>
                <span class="guide-count">0</span>
            </div>
            <div class="guide-row" data-gesture="INDEX">
                <span class="guide-emoji">☝️</span>
                <span class="guide-text">One finger → play selected</span>
                <span class="guide-count">1</span>
            </div>
            <div class="guide-row" data-gesture="VICTORY">
                <span class="guide-emoji">✌️</span>
                <span class="guide-text">Two fingers → next card →</span>
                <span class="guide-count">2</span>
            </div>
            <div class="guide-row" data-gesture="THREE">
                <span class="guide-emoji">🤟</span>
                <span class="guide-text">Three fingers → ← previous</span>
                <span class="guide-count">3</span>
            </div>
            <div class="guide-row" data-gesture="PINCH">
                <span class="guide-emoji">🤏</span>
                <span class="guide-text">Pinch → delete selected</span>
                <span class="guide-count">●</span>
            </div>

            <div class="guide-divider"></div>
            <div class="guide-subtitle">File Actions</div>

            <div class="guide-row" data-gesture="ROCK">
                <span class="guide-emoji">🤘</span>
                <span class="guide-text">Rock → download selected ⬇</span>
                <span class="guide-count">⬇</span>
            </div>
            <div class="guide-row" data-gesture="SHAKA">
                <span class="guide-emoji">🤙</span>
                <span class="guide-text">Shaka → share selected ↗</span>
                <span class="guide-count">↗</span>
            </div>
        </div>
    </section>

    <section class="notes-panel">
        <div class="notes-header">
            <h2>Voice Notes</h2>
            <div class="notes-nav">
                <button class="nav-btn" id="prevBtn">‹</button>
                <span class="notes-count-badge" id="notesCount">0</span>
                <button class="nav-btn" id="nextBtn">›</button>
            </div>
        </div>
